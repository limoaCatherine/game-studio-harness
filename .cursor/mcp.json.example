{
    "$comment": "EXAMPLE ONLY — placeholders (${LARK_APP_ID}, ${HARNESS_APPS}, …). Copy to a local mcp.json. Do not commit a live mcp.json or real credentials.",
    "mcpServers": {
        "blender-mcp": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
                "--name",
                "blender-mcp",
                "--cache",
                "${MCP_BOOT}\\cache\\blender-mcp.tools.json",
                "--framing",
                "ndjson",
                "--",
                "cmd",
                "/c",
                "${UVX}",
                "--python",
                "3.11",
                "blender-mcp"
            ],
            "env": {
                "UV_PYTHON_PREFERENCE": "only-managed",
                "DISABLE_TELEMETRY": "true",
                "PYTHONUNBUFFERED": "1"
            }
        },
        "cascadeur": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}/http_bridge.py",
                "--name",
                "cascadeur",
                "--url",
                "http://127.0.0.1:8765/mcp",
                "--tools",
                "${MCP_BOOT}/cache/cascadeur.tools.json"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        "chrome-devtools": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
                "--name",
                "chrome-devtools",
                "--cache",
                "${MCP_BOOT}\\cache\\chrome-devtools.tools.json",
                "--framing",
                "ndjson",
                "--",
                "cmd",
                "/c",
                "${NPX}",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        "cloudcompare": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
                "--name",
                "cloudcompare",
                "--cache",
                "${MCP_BOOT}\\cache\\cloudcompare.tools.json",
                "--framing",
                "ndjson",
                "--",
                "${HARNESS_APPS}\\mcp\\cloudcompare-mcp\\.venv\\Scripts\\cloudcompare-mcp.exe"
            ],
            "env": {
                "CLOUDCOMPARE_PATH": "${HARNESS_APPS}\\DCC\\CloudCompare\\CloudCompare\\CloudCompare.exe",
                "PYTHONUNBUFFERED": "1"
            }
        },
        "docker-mcp": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
                "--name",
                "docker-mcp",
                "--cache",
                "${MCP_BOOT}\\cache\\docker-mcp.tools.json",
                "--framing",
                "ndjson",
                "--",
                "${DOCKER}",
                "run",
                "-i",
                "--rm",
                "-v",
                "//./pipe/dockerDesktopLinuxEngine://./pipe/docker_engine",
                "gavinlucas/docker-mcp-server:latest"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        "everything-search": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
                "--name",
                "everything-search",
                "--cache",
                "${MCP_BOOT}\\cache\\everything-search.tools.json",
                "--framing",
                "ndjson",
                "--",
                "${HARNESS_APPS}\\mcp\\everything-mcp\\.venv\\Scripts\\everything-mcp.exe"
            ],
            "env": {
                "EVERYTHING_ES_PATH": "${HARNESS_APPS}\\mcp\\everything-mcp\\es\\es.exe",
                "PYTHONUNBUFFERED": "1"
            }
        },
        "excelMCP": {
            "command": "${EXCEL_MCP_PYTHON}",
            "args": [
                "${HARNESS_APPS}/mcp/excel-unified/server.py"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1",
                "EXCEL_COM_CMD": "${DOTNET_TOOLS}/mcp-excel.exe"
            }
        },
        "fmod-studio": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
                "--name",
                "fmod-studio",
                "--cache",
                "${MCP_BOOT}\\cache\\fmod-studio.tools.json",
                "--framing",
                "ndjson",
