                "${HARNESS_APPS}\\mcp\\fmod-studio-mcp\\.venv\\Scripts\\fmod-studio-mcp.exe"
            ],
            "env": {
                "FMOD_STUDIO_HOST": "127.0.0.1",
                "FMOD_STUDIO_PORT": "3663",
                "PYTHONUNBUFFERED": "1"
            }
        },
        "gamedev-mcp": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
                "--name",
                "gamedev-mcp",
                "--cache",
                "${MCP_BOOT}\\cache\\gamedev-mcp.tools.json",
                "--framing",
                "ndjson",
                "--",
                "${HARNESS_APPS}\\mcp\\gamedev-mcp-server\\gamedev-mcp-server.exe",
                "--port=28080"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1",
                "MCP_PLUGIN_PORT": "28080",
                "MCP_PLUGIN_CLIENT_TRANSPORT": "stdio",
                "MCP_AUTH": "none",
                "MCP_BIND": "loopback"
            }
        },
        "instant-meshes": {
            "command": "${PYTHON}",
            "args": [
                "${MCP_BOOT}\\lazy_stdio.py",
