                "${HARNESS_APPS}\\mcp\\instant-meshes-mcp\\server.py"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1",
                "BLENDER_EXECUTABLE": "${HARNESS_APPS}\\DCC\\Blender\\blender.exe",
                "INSTANT_MESHES_ALLOW_ANY_BLENDER": "1"
            }
        },
