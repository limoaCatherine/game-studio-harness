[
  {
    "name": "handoff_notes",
    "description": "Write human checklist: AccuRIG GUI auto-rig -> export FBX -> Blender/engine.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_name": {
          "default": "default",
          "title": "Workspace Name",
          "type": "string"
        }
      },
      "title": "handoff_notesArguments"
    }
  },
  {
    "name": "launch",
    "description": "Launch AccuRIG GUI (non-blocking).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "extra_args": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Args"
        }
      },
      "title": "launchArguments"
    }
  },
  {
    "name": "list_outputs",
    "description": "List fbx/obj/glb/gltf under workspace out/ (and all workspaces if name omitted).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Name"
        }
      },
      "title": "list_outputsArguments"
    }
  },
  {
    "name": "list_recent",
    "description": "List recent mesh files under workspace and host dir by mtime.",
