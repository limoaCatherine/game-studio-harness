      "type": "object",
      "properties": {
        "limit": {
          "default": 20,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "list_recentArguments"
    }
  },
  {
    "name": "open_file",
    "description": "Open a mesh path in AccuRIG if the host accepts CLI path args.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "open_fileArguments"
    }
  },
  {
    "name": "prepare_workspace",
    "description": "Create workspace folders in/out/notes under AccuRIG _mcp-workspace.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "prepare_workspaceArguments"
    }
  },
  {
    "name": "queue_open",
    "description": "Validate paths, write queue.json, open first file in AccuRIG. No batch CLI.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "paths_csv": {
          "title": "Paths Csv",
          "type": "string"
