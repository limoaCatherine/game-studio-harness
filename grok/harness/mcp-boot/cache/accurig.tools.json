          "default": "default",
          "title": "Workspace Name",
          "type": "string"
        }
      },
      "required": [
        "paths_csv"
      ],
      "title": "queue_openArguments"
    }
  },
  {
    "name": "status",
    "description": "Host exe presence + workspace root. Boundary: launch/file-level only.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "validate_mesh_input",
    "description": "Validate mesh exists and suffix is fbx/obj/glb/gltf; return size stats.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "validate_mesh_inputArguments"
    }
