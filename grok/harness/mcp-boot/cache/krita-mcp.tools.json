    "inputSchema": {
      "type": "object",
      "properties": {
        "filename": {
          "default": "canvas.png",
          "type": "string",
          "description": "Output filename (saved to configured output directory)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "krita_get_canvas_info",
