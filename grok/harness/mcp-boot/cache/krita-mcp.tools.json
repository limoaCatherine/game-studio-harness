  {
    "name": "krita_new_canvas",
    "description": "Create a new canvas in Krita.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "width": {
          "default": 800,
          "type": "integer",
          "description": "Canvas width in pixels (default 800, max 8192)"
        },
        "height": {
          "default": 600,
          "type": "integer",
          "description": "Canvas height in pixels (default 600, max 8192)"
        },
        "name": {
          "default": "New Canvas",
          "type": "string",
          "description": "Document name"
        },
        "background": {
          "default": "#1a1a2e",
          "type": "string",
          "description": "Background color as hex (default dark blue)"
        }
      },
      "additionalProperties": false
    }
  },
  {
