    "inputSchema": {
      "type": "object",
      "properties": {
        "batch_id": {
          "type": "string",
          "description": "The unique ID returned by a previous krita_batch call."
        }
      },
      "required": [
        "batch_id"
      ],
      "additionalProperties": false
    }
  },
