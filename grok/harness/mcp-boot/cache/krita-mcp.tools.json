[
  {
    "name": "krita_batch",
    "description": "Execute multiple commands in a single batch.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "commands": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array",
          "description": "List of command objects, each with \"action\" and optional \"params\""
        },
        "stop_on_error": {
          "default": false,
          "type": "boolean",
          "description": "Stop executing remaining commands on first error"
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_border_selection",
    "description": "Create a border selection around the current selection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pixels": {
          "type": "integer"
        }
      },
      "required": [
        "pixels"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_clear",
    "description": "Clear the canvas to a solid color.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "color": {
          "default": "#1a1a2e",
          "type": "string",
          "description": "Color to fill canvas with (default dark blue)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "krita_clear_selection",
    "description": "Clear the content of the current selection.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "krita_deselect",
    "description": "Remove the current selection.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "krita_draw_shape",
    "description": "Draw a shape on the canvas.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "string",
          "description": "Type of shape - \"rectangle\", \"ellipse\", or \"line\""
        },
        "x": {
          "type": "integer",
          "description": "X coordinate (top-left for shapes, start point for lines)"
        },
        "y": {
          "type": "integer",
          "description": "Y coordinate (top-left for shapes, start point for lines)"
        },
        "width": {
          "default": 100,
          "type": "integer",
          "description": "Width of shape (ignored for lines if x2/y2 provided)"
        },
        "height": {
          "default": 100,
          "type": "integer",
          "description": "Height of shape (ignored for lines if x2/y2 provided)"
        },
        "fill": {
          "default": true,
          "type": "boolean",
          "description": "Whether to fill the shape"
        },
        "stroke": {
          "default": false,
          "type": "boolean",
          "description": "Whether to draw outline"
        },
        "x2": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End X for lines (optional)"
        },
        "y2": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End Y for lines (optional)"
        }
      },
      "required": [
        "shape",
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_fill",
    "description": "Fill an area with current color (paints a filled circle at the point).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "description": "X coordinate"
        },
        "y": {
          "type": "integer",
          "description": "Y coordinate"
        },
        "radius": {
          "default": 50,
          "type": "integer",
          "description": "Fill radius in pixels"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_fill_selection",
    "description": "Fill the current selection with the foreground color.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "krita_get_canvas",
