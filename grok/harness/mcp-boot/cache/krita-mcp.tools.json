  {
    "name": "krita_select_by_alpha",
    "description": "Select pixels by alpha value range.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "min_alpha": {
          "default": 1,
          "type": "integer",
          "description": "Minimum alpha value 0-255 (default 1)."
        },
        "max_alpha": {
          "default": 255,
          "type": "integer",
          "description": "Maximum alpha value 0-255 (default 255)."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "krita_select_by_color",
    "description": "Select pixels by color similarity.\n\nUse x,y for magic wand (contiguous region from point).\nOmit x,y for global color selection across entire canvas.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "X coordinate for magic wand (None for global)."
        },
        "y": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Y coordinate for magic wand (None for global)."
        },
        "tolerance": {
          "default": 0.1,
          "type": "number",
          "description": "Color tolerance 0.0-1.0 (default 0.1)."
        },
        "contiguous": {
          "default": true,
          "type": "boolean",
          "description": "True for magic wand, False for global (default True)."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "krita_select_ellipse",
    "description": "Select an elliptical area on the canvas.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cx": {
          "type": "integer",
          "description": "X coordinate of center"
        },
        "cy": {
          "type": "integer",
          "description": "Y coordinate of center"
        },
        "rx": {
          "type": "integer",
          "description": "Horizontal radius"
        },
        "ry": {
          "type": "integer",
          "description": "Vertical radius"
        }
      },
      "required": [
        "cx",
        "cy",
        "rx",
        "ry"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_select_polygon",
    "description": "Select a polygonal area on the canvas.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "points": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array",
          "description": "List of [x, y] coordinate pairs (minimum 3 points)"
        }
      },
      "required": [
        "points"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_select_rect",
    "description": "Select a rectangular area on the canvas.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "description": "X coordinate of top-left corner"
        },
        "y": {
          "type": "integer",
          "description": "Y coordinate of top-left corner"
        },
        "width": {
          "type": "integer",
          "description": "Width of the selection"
        },
        "height": {
          "type": "integer",
          "description": "Height of the selection"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    }
  },
