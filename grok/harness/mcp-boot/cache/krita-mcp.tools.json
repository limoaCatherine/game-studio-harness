  {
    "name": "krita_set_brush",
    "description": "Set brush preset and properties.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Brush preset name (partial match, e.g., \"Basic\", \"Soft\", \"Airbrush\")"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Brush size in pixels"
        },
        "opacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Brush opacity (0.0 to 1.0)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "krita_set_color",
    "description": "Set the foreground paint color.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "description": "Hex color code (e.g., \"#ff6b6b\", \"#b8a9c9\")"
        }
      },
      "required": [
        "color"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_shrink_selection",
    "description": "Shrink the current selection inward by N pixels.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pixels": {
          "type": "integer"
        }
      },
      "required": [
        "pixels"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_stroke",
    "description": "Paint a stroke through a series of points.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "points": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array",
          "description": "List of [x, y] coordinate pairs, e.g., [[100, 100], [150, 120], [200, 150]]"
        },
        "pressure": {
          "default": 1,
          "type": "number",
          "description": "Brush pressure (0.0 to 1.0, affects stroke thickness/opacity)"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Brush size in pixels (overrides current brush size)"
        },
        "hardness": {
          "default": 0.5,
          "type": "number",
          "description": "Stroke hardness (0.0 = very soft, 1.0 = hard edge)"
        },
        "opacity": {
          "default": 1,
          "type": "number",
          "description": "Stroke opacity (0.0 to 1.0)"
        }
      },
      "required": [
        "points"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "krita_transform_selection",
    "description": "Transform the current selection (move, rotate, scale).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dx": {
          "default": 0,
          "type": "integer",
          "description": "Horizontal offset in pixels"
        },
        "dy": {
          "default": 0,
          "type": "integer",
          "description": "Vertical offset in pixels"
        },
        "angle": {
          "default": 0,
          "type": "number",
          "description": "Rotation angle in degrees"
        },
        "scale_x": {
          "default": 1,
          "type": "number",
          "description": "Horizontal scale factor"
        },
        "scale_y": {
          "default": 1,
          "type": "number",
          "description": "Vertical scale factor"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "krita_undo",
    "description": "Undo the last action.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
