  {
    "name": "xmind_add_topic",
    "description": "Add a single child topic to an existing parent topic.\n\nReturns the new topic's JSON (including its generated ID).\nUse *index* to control position among siblings (default: append).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
