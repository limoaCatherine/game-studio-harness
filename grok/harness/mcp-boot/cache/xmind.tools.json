[
  {
    "name": "xmind_open_map",
    "description": "Open an XMind file and return a compact tree view of its structure.\n\nEvery node is annotated with its ID so you can reference it in\nsubsequent add/update/delete/move calls.  Use *max_depth* to limit\nhow deep the tree is rendered (useful for large maps -- drill into\nspecific branches with xmind_get_topic afterwards).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "max_depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
  {
