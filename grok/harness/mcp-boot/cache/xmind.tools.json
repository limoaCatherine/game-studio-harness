  {
    "name": "xmind_search_topics",
    "description": "Search for topics matching a text query across the mind map.\n\n*search_in* controls which fields are searched. Defaults to\n[\"title\", \"notes\", \"labels\"].  Returns matching topics with their\nIDs, paths, and matched fields.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "search_in": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "case_sensitive": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "query"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
