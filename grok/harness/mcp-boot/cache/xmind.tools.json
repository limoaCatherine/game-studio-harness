  {
    "name": "xmind_add_subtree",
    "description": "Add a branch with nested children to an existing parent topic.\n\n*children* is a list of topic dicts, each with at minimum a \"title\"\nkey and an optional \"children\" list for nesting.  IDs are generated\nautomatically.\n\nExample children:\n  [{\"title\": \"A\", \"children\": [{\"title\": \"A1\"}, {\"title\": \"A2\"}]},\n   {\"title\": \"B\"}]",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "children": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "parent_id",
        "children"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "_meta": {
      "fastmcp": {
        "tags": []
      }
    }
  },
