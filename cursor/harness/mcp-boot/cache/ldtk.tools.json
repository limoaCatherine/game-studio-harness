[
  {
    "name": "add_level",
    "description": "追加一个空关卡（复制首个 Entities 层定义结构）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "level_id": {
          "title": "Level Id",
          "type": "string"
        },
        "px_wid": {
          "default": 512,
          "title": "Px Wid",
          "type": "integer"
        },
        "px_hei": {
          "default": 512,
          "title": "Px Hei",
          "type": "integer"
        },
        "world_x": {
          "default": 0,
          "title": "World X",
          "type": "integer"
        },
        "world_y": {
          "default": 0,
          "title": "World Y",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "level_id"
      ],
      "title": "add_levelArguments"
    }
  },
  {
    "name": "create_blank_project",
    "description": "创建最小可打开的空白 .ldtk 工程（含一个 Empty 关卡）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "px_wid": {
          "default": 512,
          "title": "Px Wid",
          "type": "integer"
        },
        "px_hei": {
          "default": 512,
          "title": "Px Hei",
          "type": "integer"
        }
      },
      "required": [
        "path"
      ],
      "title": "create_blank_projectArguments"
    }
  },
  {
    "name": "duplicate_level",
    "description": "复制关卡（深拷贝并换新 iid/uid）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "source_level_id": {
          "title": "Source Level Id",
          "type": "string"
        },
        "new_level_id": {
          "title": "New Level Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source_level_id",
        "new_level_id"
      ],
      "title": "duplicate_levelArguments"
    }
  },
  {
    "name": "get_level",
    "description": "按 identifier 取单个 level 对象。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "level_id": {
          "title": "Level Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "level_id"
      ],
      "title": "get_levelArguments"
    }
  },
  {
    "name": "launch_ldtk",
    "description": "可选打开 .ldtk；仅启动进程，不自动化编辑器。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "title": "launch_ldtkArguments"
    }
  },
  {
    "name": "list_entities",
    "description": "列出关卡内实体（可按层过滤）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "level_id": {
          "title": "Level Id",
          "type": "string"
        },
        "layer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer Id"
        }
      },
      "required": [
        "path",
        "level_id"
      ],
      "title": "list_entitiesArguments"
    }
  },
  {
    "name": "list_projects",
    "description": "列出工作区内 .ldtk 文件。",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "read_ldtk",
    "description": "读取 .ldtk；summary_only=true 时只返回元数据与关卡名。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "summary_only": {
          "default": true,
          "title": "Summary Only",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "read_ldtkArguments"
    }
  },
  {
    "name": "set_level_field",
    "description": "设置 level 顶层字段（value_json 为 JSON 字面量）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "level_id": {
          "title": "Level Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value_json": {
          "title": "Value Json",
          "type": "string"
        }
      },
      "required": [
        "path",
        "level_id",
        "field",
        "value_json"
      ],
      "title": "set_level_fieldArguments"
    }
  },
  {
    "name": "status",
    "description": "工作区与 LDtk.exe 状态。",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "write_ldtk",
    "description": "写入完整 .ldtk JSON 文本（必须是合法 JSON 对象）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "json_text": {
          "title": "Json Text",
          "type": "string"
        }
      },
      "required": [
        "path",
        "json_text"
      ],
      "title": "write_ldtkArguments"
    }
  }
]
