[
  {
    "name": "handoff_notes",
    "description": "Write human checklist: TreeIt grow -> export mesh -> Blender/engine.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_name": {
          "default": "default",
          "title": "Workspace Name",
          "type": "string"
        }
      },
      "title": "handoff_notesArguments"
    }
  },
  {
    "name": "launch",
    "description": "Launch TreeIt GUI (non-blocking).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "extra_args": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Args"
        }
      },
      "title": "launchArguments"
    }
  },
  {
    "name": "list_outputs",
    "description": "List export candidates under workspace out/ (or all workspaces).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Name"
        }
      },
      "title": "list_outputsArguments"
    }
  },
  {
    "name": "list_recent",
    "description": "List recent tree/mesh/image files under workspace and host dir by mtime.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "default": 20,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "list_recentArguments"
    }
  },
  {
    "name": "open_file",
    "description": "Open a path in TreeIt if the host accepts CLI path args.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "open_fileArguments"
    }
  },
  {
    "name": "prepare_workspace",
    "description": "Create workspace folders in/out/notes under TreeIt _mcp-workspace.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "prepare_workspaceArguments"
    }
  },
  {
    "name": "queue_open",
    "description": "Validate paths, write queue.json, open first ok file. No batch grow CLI.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "paths_csv": {
          "title": "Paths Csv",
          "type": "string"
        },
        "workspace_name": {
          "default": "default",
          "title": "Workspace Name",
          "type": "string"
        }
      },
      "required": [
        "paths_csv"
      ],
      "title": "queue_openArguments"
    }
  },
  {
    "name": "status",
    "description": "Host exe presence + workspace root. Boundary: launch/file-level only.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "validate_tree_input",
    "description": "Validate input exists and suffix looks usable for TreeIt workflow (.ttr/.obj/.fbx/images).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "validate_tree_inputArguments"
    }
  }
]
