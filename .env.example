# EXAMPLE ONLY — copy to a local `.env`. Never commit a real `.env`.
# GSH does not require these variables. Names match `harness/mcp.json.example`
# placeholders. Replace values on your machine; leave unused keys empty.

# Lark / Feishu (optional). Real app id/secret stay in local secret storage.
LARK_APP_ID=
LARK_APP_SECRET=

# Host-apps root used by MCP command templates. Use ${HARNESS_APPS} in JSON,
# not a user-profile absolute path.
HARNESS_APPS=
