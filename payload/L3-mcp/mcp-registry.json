{
  "version": 1,
  "note": "只描述怎么注册。软件路径是占位符。密钥不进包。",
  "core": [
    "excelMCP"
  ],
  "already_lazy": [
    "cascadeur"
  ],
  "url_passthrough": [
    "miro"
  ],
  "default_framing": "ndjson",
  "servers": [
    {
      "id": "blender-mcp",
      "tier": "lazy",
      "wrap": "lazy_stdio",
      "transport": "stdio",
      "launch_kind": "uvx",
      "backend_entry": [
        "cmd",
        "/c",
        "${UVX}",
        "--python",
        "3.11",
        "blender-mcp"
      ],
      "env_keys": [
        "DISABLE_TELEMETRY",
        "PYTHONUNBUFFERED",
        "UV_PYTHON_PREFERENCE"
      ],
      "framing": "ndjson"
    },
    {
      "id": "cascadeur",
      "tier": "lazy",
      "wrap": "none",
      "transport": "stdio",
      "launch_kind": "python-server",
      "backend_entry": [
        "${MCP_BOOT}\\http_bridge.py",
        "--name",
        "cascadeur",
        "--url",
        "http://127.0.0.1:8765/mcp",
        "--tools",
        "${MCP_BOOT}\\cache\\cascadeur.tools.json"
      ],
      "env_keys": [
        "PYTHONUNBUFFERED"
      ],
      "framing": "ndjson"
    },
    {
      "id": "chrome-devtools",
