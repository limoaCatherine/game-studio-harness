[
  {
    "name": "handoff_notes",
    "description": "Write human checklist: Studio clean -> export FBX/BVH -> Blender/engine.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_name": {
          "default": "default",
          "title": "Workspace Name",
          "type": "string"
        }
      },
      "title": "handoff_notesArguments"
    }
  },
  {
    "name": "launch",
    "description": "Launch Rokoko Studio GUI (non-blocking).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "extra_args": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Args"
        }
      },
      "title": "launchArguments"
    }
  },
  {
    "name": "list_outputs",
    "description": "List export candidates under workspace out/ (or all workspaces).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Name"
        }
      },
      "title": "list_outputsArguments"
    }
  },
  {
    "name": "list_recent",
    "description": "List recent fbx/bvh/json under workspace and host dir.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "default": 20,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "list_recentArguments"
    }
  },
  {
    "name": "open_file",
    "description": "Open a path in Rokoko Studio if CLI path args are accepted.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "open_fileArguments"
    }
  },
  {
    "name": "prepare_workspace",
    "description": "Create in/out/notes under Rokoko _mcp-workspace.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "prepare_workspaceArguments"
    }
  },
  {
    "name": "probe_listen_port",
    "description": "TCP connect probe to Studio Listen API port. Does not parse mocap frames.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "timeout_sec": {
          "default": 0.5,
          "title": "Timeout Sec",
          "type": "number"
        }
      },
      "title": "probe_listen_portArguments"
    }
  },
  {
    "name": "queue_open",
    "description": "Validate clips, write queue.json, open first ok file. No batch retarget CLI.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "paths_csv": {
          "title": "Paths Csv",
          "type": "string"
        },
        "workspace_name": {
          "default": "default",
          "title": "Workspace Name",
          "type": "string"
        }
      },
      "required": [
        "paths_csv"
      ],
      "title": "queue_openArguments"
    }
  },
  {
    "name": "status",
    "description": "Host exe + workspace. Boundary: no GUI mocap control.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "validate_clip_input",
    "description": "Validate mocap clip path exists and suffix is fbx/bvh/json/csv.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "validate_clip_inputArguments"
    }
  }
]
